digraph archi {
  rankdir=LR;
  bgcolor="white";
  node [fontname="DejaVu Sans", fontsize=11, shape=box, style=filled,
        fillcolor="#F5F5F5", color="#555555"];
  edge [color="#555555"];

  yahoo [label="Yahoo Finance"];
  frank [label="Frankfurter (BCE)"];
  wb    [label="Banque Mondiale"];
  airflow [label="Airflow"];
  raw   [label="BigQuery\nraw", fillcolor="#E8E8E8"];
  dbt   [label="dbt"];
  marts [label="BigQuery\nmarts", fillcolor="#E8E8E8"];
  bi    [label="Looker Studio\nPower BI"];

  yahoo -> airflow;
  frank -> airflow;
  wb -> airflow;
  airflow -> raw -> dbt -> marts -> bi;
}
