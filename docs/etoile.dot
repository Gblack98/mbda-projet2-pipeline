digraph modele {
  bgcolor="white";
  rankdir=TB;
  node [fontname="DejaVu Sans Mono", fontsize=10, shape=record, style=filled,
        fillcolor="#F5F5F5", color="#555555"];
  edge [color="#555555", arrowhead=none];

  temps [label="{dim_temps|date_jour\lannee\ltrimestre\lmois\ljour_semaine\lest_weekend\l}"];
  instr [label="{dim_instrument|instrument_id\llibelle\lclasse_actif\lsecteur\lsous_secteur\lcategorie_export\l}"];
  devise [label="{dim_devise|devise_id\lnom_devise\lsymbole\l}"];

  fct [label="{fct_cotation_journaliere|date_cotation\linstrument_id\ldevise_cotation\ldevise_pivot\louverture / plus_haut / plus_bas\lcloture\lcloture_eur\lvolume\l}",
       fillcolor="#E8E8E8", color="#222222"];

  pays [label="{dim_pays_exposition|pays\lcategorie\lderniere_annee_disponible\lpoids_export\l}"];

  temps -> fct;
  instr -> fct;
  devise -> fct;

  {rank=same; temps; instr; devise;}
  {rank=same; fct; pays;}
}
