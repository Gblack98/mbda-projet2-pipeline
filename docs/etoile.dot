digraph constellation {
  bgcolor="#F1F4F2";
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans Mono", fontsize=10, shape=plain];
  edge [color="#3D4F48", penwidth=1.1, arrowhead=none];

  temps [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B45309" BGCOLOR="white">
      <TR><TD BGCOLOR="#B45309"><FONT COLOR="white"><B>dim_temps</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">date_id (PK)</TD></TR>
      <TR><TD ALIGN="LEFT">annee · trimestre · mois</TD></TR>
      <TR><TD ALIGN="LEFT">semaine · est_jour_ouvre</TD></TR>
    </TABLE>>];

  instr [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B45309" BGCOLOR="white">
      <TR><TD BGCOLOR="#B45309"><FONT COLOR="white"><B>dim_instrument</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">instrument_id (PK)</TD></TR>
      <TR><TD ALIGN="LEFT">libelle</TD></TR>
      <TR><TD ALIGN="LEFT">classe_actif ► secteur ► sous_secteur</TD></TR>
      <TR><TD ALIGN="LEFT">secteur (FK vers dim_secteur)</TD></TR>
    </TABLE>>];

  devise [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B45309" BGCOLOR="white">
      <TR><TD BGCOLOR="#B45309"><FONT COLOR="white"><B>dim_devise</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">devise_id (PK)</TD></TR>
      <TR><TD ALIGN="LEFT">libelle · symbole</TD></TR>
      <TR><TD ALIGN="LEFT">regime</TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#FFF7EC"><I>dérivé : coef. de variation sous seuil</I></TD></TR>
    </TABLE>>];

  secteur [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B45309" BGCOLOR="white">
      <TR><TD BGCOLOR="#B45309"><FONT COLOR="white"><B>dim_secteur</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">secteur (PK)</TD></TR>
      <TR><TD ALIGN="LEFT">categorie_export</TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#FFF7EC"><I>correspondance N:1 déclarée</I></TD></TR>
    </TABLE>>];

  fct1 [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#0F766E" BGCOLOR="white">
      <TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>fct_cotation_journaliere</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#DCEDEA"><I>grain : instrument × jour</I></TD></TR>
      <TR><TD ALIGN="LEFT">date_id (FK) · instrument_id (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">devise_id (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">ouverture · cloture · haut · bas · volume</TD></TR>
      <TR><TD ALIGN="LEFT">cloture_normalisee (÷100 si USX, GBp, ZAc)</TD></TR>
      <TR><TD ALIGN="LEFT">cloture_eur · variation_pct · volatilite_10j</TD></TR>
    </TABLE>>];

  fct2 [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#0F766E" BGCOLOR="white">
      <TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>fct_exportations_pays</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#DCEDEA"><I>grain : pays × catégorie × année</I></TD></TR>
      <TR><TD ALIGN="LEFT">pays · annee</TD></TR>
      <TR><TD ALIGN="LEFT">categorie_export (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">part_exportations</TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#FFF7EC"><I>Banque Mondiale — jamais joint</I></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#FFF7EC"><I>directement aux cotations</I></TD></TR>
    </TABLE>>];

  temps -> fct1; instr -> fct1; devise -> fct1;
  instr -> secteur; secteur -> fct2;

  {rank=same; temps; instr; devise;}
  {rank=same; fct1; fct2;}
}
